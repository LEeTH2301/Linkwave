<UserControl x:Class="Linkwave.LyricsMiniPlayer" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,3">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#EDF5EE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#395345"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Background" Value="#4F6958"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Path">
            <Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Geometry x:Key="Play">M5,3 L16,10 5,17 Z</Geometry>
        <Geometry x:Key="Pause">M4,3 H7 V17 H4 Z M12,3 H15 V17 H12 Z</Geometry>
        <Geometry x:Key="Repeat">M2,9 V7 Q2,4 5,4 H17 M14,1 L17,4 14,7 M18,11 V13 Q18,16 15,16 H3 M6,13 L3,16 6,19</Geometry>
        <Geometry x:Key="RepeatOne">M2,9 V7 Q2,4 5,4 H17 M14,1 L17,4 14,7 M18,11 V13 Q18,16 15,16 H3 M6,13 L3,16 6,19 M8.5,9 L10.5,7.5 V12.5</Geometry>
    </UserControl.Resources>
    <Border Background="#F023302A" BorderBrush="#6E8276" BorderThickness="1" CornerRadius="7" Padding="2,1">
        <StackPanel Orientation="Horizontal" Button.Click="ControlClick">
            <Button x:Name="Previous" Tag="prev" ToolTip="이전 곡" AutomationProperties.Name="이전 곡"><Path Data="M4,3 V17 M16,3 L6,10 16,17 Z" Fill="{Binding Stroke,RelativeSource={RelativeSource Self}}"/></Button>
            <Button x:Name="PlayPause" Tag="play"><Path x:Name="PlayIcon" Data="{StaticResource Play}" Fill="{Binding Stroke,RelativeSource={RelativeSource Self}}"/></Button>
            <Button x:Name="StopTrack" Tag="stop" ToolTip="정지" AutomationProperties.Name="정지"><Path Width="12" Height="12" Data="M3,3 H15 V15 H3 Z" Fill="{Binding Stroke,RelativeSource={RelativeSource Self}}"/></Button>
            <Button x:Name="Next" Tag="next" ToolTip="다음 곡" AutomationProperties.Name="다음 곡"><Path Data="M16,3 V17 M4,3 L14,10 4,17 Z" Fill="{Binding Stroke,RelativeSource={RelativeSource Self}}"/></Button>
            <Button x:Name="Shuffle" Tag="shuffle"><Path Data="M2,5 H4 Q6,5 9,10 T15,15 H18 M15,12 L18,15 15,18 M2,15 H4 Q6,15 8,12 M11,8 Q13,5 15,5 H18 M15,2 L18,5 15,8"/></Button>
            <Button x:Name="RepeatMode" Tag="repeat"><Path x:Name="RepeatIcon" Data="{StaticResource Repeat}"/></Button>
            <Button x:Name="Quieter" Tag="quieter"><Path Data="M1,8 H4 L9,4 V16 L4,12 H1 Z M12,10 H18"/></Button>
            <Button x:Name="Louder" Tag="louder"><Path Data="M1,8 H4 L9,4 V16 L4,12 H1 Z M12,10 H18 M15,7 V13"/></Button>
        </StackPanel>
    </Border>
</UserControl>
